{
    "openapi": "3.0.0",
    "info": {
        "title": "BPM API",
        "description": "A Business Process Management API with a dynamic rule engine and immutable versioning.",
        "contact": {
            "email": "support@example.com"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/flows": {
            "get": {
                "tags": [
                    "Flows"
                ],
                "summary": "Display a listing of the resource.",
                "operationId": "e9e7f60ded54b285f3d24b4ac7250253",
                "responses": {
                    "200": {
                        "description": "Successful operation."
                    }
                }
            },
            "post": {
                "tags": [
                    "Flows"
                ],
                "summary": "Store a newly created resource in storage.",
                "operationId": "d12af90b3426c7fe578944957cc30856",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "flow_structure"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "New Flow"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "A description for the new flow."
                                    },
                                    "flow_structure": {
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Flow created successfully."
                    }
                }
            }
        },
        "/flows/{id}": {
            "get": {
                "tags": [
                    "Flows"
                ],
                "summary": "Retrieve the master Flow and its latest version definition.",
                "operationId": "1882a97c8d6acdd4a356a61b0c5c6218",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation."
                    }
                }
            },
            "put": {
                "tags": [
                    "Flows"
                ],
                "summary": "Update a flow and create a new version.",
                "operationId": "69646e0d6acf494f8c69772d2c2b8986",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "flow_structure"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Updated Flow Name"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Updated description."
                                    },
                                    "flow_structure": {
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Flow updated successfully."
                    }
                }
            },
            "delete": {
                "tags": [
                    "Flows"
                ],
                "summary": "Conditional Soft Delete a Flow.",
                "operationId": "11031b602aeb7bdb1a1e83d46ce67d59",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Flow deleted successfully."
                    },
                    "409": {
                        "description": "Conflict, in-flight tickets exist."
                    }
                }
            }
        },
        "/flows/{id}/versions": {
            "get": {
                "tags": [
                    "Flows"
                ],
                "summary": "Retrieve all immutable flow versions.",
                "operationId": "de8a0a172faf5b6988bea82e1237550c",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation."
                    }
                }
            }
        },
        "/tickets": {
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Create a new ticket instance.",
                "operationId": "0f82fdde1437d948b90892e1b714a1cc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "flow_id"
                                ],
                                "properties": {
                                    "flow_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "ticket_data": {
                                        "type": "object",
                                        "example": {
                                            "priority": "High"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Ticket created successfully."
                    },
                    "400": {
                        "description": "Bad request, e.g., flow has no start stage."
                    }
                }
            }
        },
        "/tickets/{ticket}": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Retrieve a ticket and its current flow context.",
                "operationId": "e266c2c37a5df4ec1d5da7565bd6e2ae",
                "parameters": [
                    {
                        "name": "ticket",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation."
                    }
                }
            }
        },
        "/tickets/{ticket}/data": {
            "put": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Update the flexible JSON payload of a ticket.",
                "operationId": "e2693dc626c94e519694f0f01ee9eb69",
                "parameters": [
                    {
                        "name": "ticket",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "data"
                                ],
                                "properties": {
                                    "data": {
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Ticket data updated successfully."
                    }
                }
            }
        },
        "/tickets/{ticket}/tasks/{taskId}": {
            "put": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Mark a specific task as complete/incomplete.",
                "operationId": "c7da260e293ddafc0c4b6c10c5ea41bf",
                "parameters": [
                    {
                        "name": "ticket",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "taskId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "is_complete"
                                ],
                                "properties": {
                                    "is_complete": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Task status updated successfully."
                    }
                }
            }
        },
        "/tickets/{ticket}/advance": {
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Advance a ticket to the next stage using the Flow's rule engine.",
                "operationId": "c41b0db9b91712cd8f2540805cb0539a",
                "parameters": [
                    {
                        "name": "ticket",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ticket successfully advanced to the next stage/status.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Ticket successfully advanced."
                                        },
                                        "current_stage_id": {
                                            "type": "integer",
                                            "example": 2
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "IN_PROGRESS"
                                        },
                                        "summary": {
                                            "properties": {
                                                "rule_passed": {
                                                    "type": "string",
                                                    "example": "High Priority Routing"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Advancement blocked due to missing mandatory tasks/checkpoints.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Advancement failed. Mandatory checkpoints are incomplete."
                                        },
                                        "validation_errors": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "task_id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "task_name": {
                                                        "type": "string",
                                                        "example": "Verify User Identity"
                                                    },
                                                    "stage_id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Advancement blocked because no routing rules qualified for the ticket data.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Advancement failed. No routing rules qualified for the ticket data."
                                        },
                                        "routing_failures": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "rule": {
                                                        "type": "string",
                                                        "example": "High Priority Routing"
                                                    },
                                                    "errors": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string",
                                                            "example": "Group 'Priority Check' failed: Condition priority_level == 'High' was not met."
                                                        }
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tokens": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Create an API token",
                "description": "Create a new API token for a user.",
                "operationId": "createToken",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "1|abcdef123456"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Flows",
            "description": "Flows"
        },
        {
            "name": "Tickets",
            "description": "Tickets"
        },
        {
            "name": "Authentication",
            "description": "Authentication"
        }
    ]
}